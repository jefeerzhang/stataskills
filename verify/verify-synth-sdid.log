. clear

. set seed 20260817

. set obs 400
Number of observations (_N) was 0, now 400.

. gen id = ceil(_n/10)

. gen t  = mod(_n-1, 10) + 1

. gen first_treat = cond(id <= 20, 3, cond(id <= 30, 7, 0))

. gen treat = (first_treat > 0 & t >= first_treat)

. gen x = rnormal()

. gen y = 2 + 0.5*t + 0.3*x + 1.0*treat + rnormal(0, 1)

