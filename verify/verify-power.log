. * 段 1：Bloom 1995 Analytical MDE
. * ===========================================================================
> ==
. display as result "=== 段 1：Bloom 1995 Analytical MDE ==="
=== 段 1：Bloom 1995 Analytical MDE ===

. 
. local N = 200

. local T = 10

. local sigma_tau = 0.2

. local sigma_eps = 1.0

. local alpha = 0.05

. local power_target = 0.80

. 
. local z_alpha = invnormal(1 - `alpha'/2)

. local z_beta  = invnormal(`power_target')

. local mde_sd = (`z_alpha' + `z_beta') * sqrt(2 * (`sigma_eps'^2) / (`N' * `T'
> ))

. 
. display as result "  N = `N', T = `T', alpha = `alpha', power = `power_target
> '"
  N = 200, T = 10, alpha = .05, power = .8

. display as result "  Bloom MDE (in SD units) = " %6.4f `mde_sd'
  Bloom MDE (in SD units) = 0.0886

. 
. * 断言：MDE 应在 [0.05, 0.15] SD 范围（与 Burlig-Preonas-Woerman 2020 Table 1
>  一致）
. assert inrange(`mde_sd', 0.05, 0.15)

. display as result "  ✓ Bloom MDE 在预期范围 [0.05, 0.15] SD"
  ✓ Bloom MDE 在预期范围 [0.05, 0.15] SD

