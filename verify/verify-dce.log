y1  -.88496555    .8642694  -1.3648034   1.4780897   23.055271  -17.224383
.     lclogitpr double Pr0, pr0
.     lclogitpr double PrC, pr
.     lclogitpr double H, up
.     lclogitpr double G, cp
.     foreach p in Pr0 PrC PrC1 PrC2 {
  2.         assert inrange(`p', 0, 1)
  3.         bysort grid: egen double sum_`p' = total(`p')
