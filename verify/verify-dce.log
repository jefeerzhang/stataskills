  5.     }
.     foreach p in H1 H2 G1 G2 {
  2.         assert inrange(`p', 0, 1)
  3.         bysort respondent (`p'): assert abs(`p' - `p'[1]) < 1e-8
  4.     }
.     assert abs(H1 + H2 - 1) < 1e-6
