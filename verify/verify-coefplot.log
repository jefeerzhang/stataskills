. * ---- 6. 矩阵绘图 ----
. sysuse auto, clear
(1978 automobile data)

. matrix median = J(1,3,.)

. matrix colnames median = mpg trunk turn

. matrix CI = J(2,3,.)

. matrix colnames CI = mpg trunk turn

. matrix rownames CI = ll95 ul95

. local i 0

. foreach v of varlist mpg trunk turn {
  2.     local ++i
  3.     quietly centile `v'
  4.     matrix median[1,`i'] = r(c_1)
  5.     matrix CI[1,`i'] = r(lb_1)
  6.     matrix CI[2,`i'] = r(ub_1)
  7. }

. coefplot matrix(median), ci(CI)

. 
