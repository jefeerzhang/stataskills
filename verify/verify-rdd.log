           |    100.00       0.00 |    100.00 
-----------+----------------------+----------
         1 |         0        241 |       241 
           |      0.00     100.00 |    100.00 
-----------+----------------------+----------
     Total |       759        241 |     1,000 
           |     75.90      24.10 |    100.00 

. 
. quietly count if below_cutoff == 1 & tutoring == 1

. local n_treated_below = r(N)

. quietly count if tutoring == 1

. local n_treat = r(N)

. 
. display "below cutoff & treated: " `n_treated_below' "（应 = " `n_treat' "，s
> harp）"
below cutoff & treated: 241（应 = 241，sharp）

. 
. if `n_treated_below' == `n_treat' {
.     display as text "sharp 设计确认（100% 合规）"
sharp 设计确认（100% 合规）
. }

. else {
.     display as text "存在交叉（fuzzy 需用 fuzzy() 选项）"
. }

. 
. display as text "第 1 步完成"
第 1 步完成

