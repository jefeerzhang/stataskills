# Stata 临时日志
*.smcl
# 数据目录只放数据：验证运行 / 教材 chapter 复现产生的日志一律不入库
data/agis6/*.log
# verify raw logs（ADR-0007）：由 run-verify.sh 本地生成，判定证据靠 .do 内的
# assert 与 VERIFY_MARKERS_REQUIRED 标记复现，不再随仓库提交完整 Stata transcript。
# 与 ADR-0005 的旧决定相反；demo/logs/*.log 仍入库（CI 硬依赖，见 check-claims.sh）。
verify/*.log
# panelview / fect 安装时复制到 demo/ 的配套数据（net install ... , all replace 会重出）
demo/simdata.dta
demo/simdata1.dta
demo/turnout.dta
# Stata graph export 路径解析异常时在 demo/ 根目录多写的副本（同 output/03_*.png）
demo/.png
# Windows 临时文件
Thumbs.db
.DS_Store

# Agent 运行产物与本地临时物（--llm 行为回归 / 架构图源 / Stata 草稿）
# .scratch/ 不可整目录当垃圾扫，内含不可再生内容：
#   archify/     ← 已提交资产 docs/stataskills-architecture.png 的唯一源
#   llm-smoke/   ← verify/llm-results.md、llm-smoke-results.md 引用的原始响应
#   *.do         ← 多数 .png / .dta 由同目录 .do 经 graph export / save 再生
/.scratch/
/.tmp/
/stata_batch__*.log
/*_test.log

# 评审与文档渲染的本地产物
# _shots/ 曾积累 14 个 headless Chrome 的 user-data-dir（Cookies / Crashpad /
# Cache），与 _tmp/ 合计 4441 条未跟踪项、约 196 MB，git status 长期被淹没。
/_shots/
/_tmp/
# 约定：对论文/外部文档的实证评审交付物写在源文件所在目录（仓库外），
# 不提交也不推送。以下两条兜住误落到仓库根的情况。
/*评审意见*.html
/*实证评审*.html
