. *---- 图 4：按系数分面（bycoefs） ---------------------------
. sysuse auto, clear
(1978 automobile data)

. forvalues i = 3/5 {
  2.     quietly regress price mpg headroom weight turn if rep78==`i'
  3.     estimates store rep78_`i'
  4. }

. coefplot rep78_3 || rep78_4 || rep78_5, drop(_cons) xline(0) ///
>         bycoefs byopts(xrescale) ///
>         title("Coefficients by repair record (bycoefs)") ///
>         scheme(s1mono)

. graph export "output/06_coefplot_bycoefs.png", replace
(file output/06_coefplot_bycoefs.png not found)
file output/06_coefplot_bycoefs.png written in PNG format

. 
end of do-file
